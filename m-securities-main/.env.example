# Copy to .env.local (local dev) or set on the production host.

# Supabase project that stores the Research content edited at /admin.
# Both are public values; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The single admin account: /admin/login asks only for its password (server-side only).
ADMIN_EMAIL=
