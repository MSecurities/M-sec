# Copy to .env.local (local dev) or set on the production host.

# Supabase project that stores the Research content edited at /admin.
# Both are public values; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The single admin account: /admin/login asks only for its password (server-side only).
ADMIN_EMAIL=

# beehiiv → "Долоо хоногийн тойм" sync (Supabase Edge Function on a Monday cron; this app adds the "beehiiv-ээс татах" button in /admin and an optional /api/cron/beehiiv route).
# API key: beehiiv → Settings → Workspace settings → API. Publication ID starts with pub_.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_ae5127fb-c0a8-44b7-a09a-606136473215
# Server-only Supabase key (Project Settings → API → service_role / secret). The cron writes with it.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel sends it to the cron route as "Authorization: Bearer …".
CRON_SECRET=
# Optional: copy posts published on/after this date (default: the last 30 days). Set 2026-03-01 once to backfill all.
BEEHIIV_SYNC_SINCE=
# Optional: "draft" to review each issue in /admin before it appears on the site (default: published right away).
BEEHIIV_SYNC_STATUS=
